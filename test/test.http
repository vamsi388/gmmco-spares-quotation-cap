{ "customerId": "1000001", "validFrom": "2026-10-07", "validTo": "2026-12-31", "currency_code": "INR",
  "items": [ { "material": "UNKNOWN-1", "quantity": 1 } ] }

### F10 Quantity zero
# EXPECT: 400 "quantity must be greater than 0"
POST {{q}}/Quotations
Authorization: Basic sales:secret
Content-Type: application/json

{ "customerId": "1000001", "validFrom": "2026-10-07", "validTo": "2026-12-31", "currency_code": "INR",
  "items": [ { "material": "CAT-1R0719", "quantity": 0 } ] }

### F11 Create an empty quotation
# EXPECT: 201
# @name createEmpty
POST {{q}}/Quotations
Authorization: Basic sales:secret
Content-Type: application/json

{ "customerId": "1000001", "validFrom": "2026-10-07", "validTo": "2026-12-31", "currency_code": "INR" }

###
@qEmpty = {{createEmpty.response.body.ID}}

### F12 Submit the empty quotation
# EXPECT: 400 "Add at least one item before submitting"
POST {{q}}/Quotations({{qEmpty}})/QuotationService.submit
Authorization: Basic sales:secret
Content-Type: application/json

{}

### F13 Client cannot set calculated fields
# EXPECT: 201, but status is "Draft" and totalValue is 0 (the values sent are ignored)
POST {{q}}/Quotations
Authorization: Basic sales:secret
Content-Type: application/json

{ "customerId": "1000001", "validFrom": "2026-10-07", "validTo": "2026-12-31", "currency_code": "INR",
  "status": "Approved", "totalValue": 999999 }

### F14 Issue a quotation that is not approved
# EXPECT: 409 "Action not allowed when status is Draft"
POST {{q}}/Quotations({{qEmpty}})/QuotationService.issue
Authorization: Basic sales:secret
Content-Type: application/json

{}

### F15 Delete a draft quotation
# EXPECT: 204
DELETE {{q}}/Quotations({{qEmpty}})
Authorization: Basic sales:secret

#####################################################################
# 9. JOBS
#####################################################################

### J1 Expire job
# EXPECT: 200, value like "0 quotation(s) expired"
POST {{host}}/odata/v4/job/expireQuotations
Authorization: Basic scheduler:secret
Content-Type: application/json

{}

### J2 Reminder job
# EXPECT: 200, value like "N reminder(s) to send"
POST {{host}}/odata/v4/job/sendReminders
Authorization: Basic scheduler:secret
Content-Type: application/json

{}

### J3 Procurement sync job
# EXPECT: 200, value like "N open procurement item(s) checked"
POST {{host}}/odata/v4/job/syncProcurement
Authorization: Basic scheduler:secret
Content-Type: application/json

