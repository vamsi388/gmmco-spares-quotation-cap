Authorization: Basic sales:secret
Content-Type: application/json

{}

### F6 Edit after cancel
# EXPECT: 409
PATCH {{q}}/Quotations({{qF}})
Authorization: Basic sales:secret
Content-Type: application/json

{ "remarks": "x" }

### F7 Unknown customer
# EXPECT: 400 "Customer 9999999 not found"
POST {{q}}/Quotations
Authorization: Basic sales:secret
Content-Type: application/json

{ "customerId": "9999999", "validFrom": "2026-10-07", "validTo": "2026-12-31", "currency_code": "INR" }

### F8 Valid-To before Valid-From
# EXPECT: 400 "Valid To cannot be earlier than Valid From"
POST {{q}}/Quotations
Authorization: Basic sales:secret
Content-Type: application/json

{ "customerId": "1000001", "validFrom": "2026-12-31", "validTo": "2026-10-07", "currency_code": "INR" }

### F9 Material with no pricing rule
# EXPECT: 400 "No active pricing rule for material UNKNOWN-1"
POST {{q}}/Quotations
Authorization: Basic sales:secret
