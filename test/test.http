Authorization: Basic sales:secret
Content-Type: application/json

{ "quotation_ID": "{{qF}}", "material": "CAT-9X3263", "quantity": 2 }

### F3 Totals after adding the item
# EXPECT: 2 items; netValue 5075 (2875 + 2200); itemNo 10 and 20
GET {{q}}/Quotations({{qF}})?$expand=items
Authorization: Basic sales:secret

